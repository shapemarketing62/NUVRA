# Database (SQLite for local dev — swap to PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# AI Provider (optional — without keys, deterministic engines are used)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Website Analyzer
MAX_CRAWL_PAGES=15
ANALYSIS_TIMEOUT_MS=120000
SCREENSHOTS_DIR=./storage/screenshots

# Meta / Instagram (optional — leave empty until credentials are ready)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# Public search/reviews providers (server-side only; never prefix with NEXT_PUBLIC_)
TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=

# Google OAuth (future Business Profile, GA4 and Search Console connectors)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# X OAuth 2.0 (optional; only relevant businesses)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/integrations/x/callback

# Authentication and encrypted integration storage
MAX_ACTIVE_SESSIONS=5
REQUIRE_VERIFIED_EMAIL_FOR=integration.connect,team.invite
# 32 random bytes encoded as base64. Required before storing integration credentials.
INTEGRATION_MASTER_KEY=

# Billing architecture (mock only until a real provider is approved)
BILLING_PROVIDER=mock
BILLING_TRIAL_DAYS=14
PRO_PRICE_LABEL=Próximamente
PARTNER_PRICE_LABEL=Próximamente
