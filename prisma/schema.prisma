generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  passwordHash            String
  emailVerifiedAt         DateTime?
  disabledAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  internalRole            String?
  auditEvents             AuditLog[]               @relation("AuditActor")
  sessions                AuthSession[]
  businesses              Business[]
  emailVerificationTokens EmailVerificationToken[]
  memberships             Membership[]
  passwordResetTokens     PasswordResetToken[]
  plan                    Plan?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id                     String                @id @default(cuid())
  name                   String
  slug                   String                @unique
  planTier               String                @default("FREE")
  subscriptionStatus     String                @default("inactive")
  subscriptionProvider   String?
  subscriptionCustomerId String?
  subscriptionId         String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  analysisRuns           AnalysisRun[]
  auditEvents            AuditLog[]
  billingWebhookEvents   BillingWebhookEvent[]
  businesses             Business[]
  integrations           Integration[]
  integrationSecrets     IntegrationSecret[]
  memberships            Membership[]
  subscription           Subscription?
  usageEvents            UsageEvent[]

  @@index([planTier])
}

model Subscription {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  plan                   String       @default("FREE")
  status                 String       @default("free")
  billingInterval        String?
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean      @default(false)
  canceledAt             DateTime?
  externalCustomerId     String?
  externalSubscriptionId String?
  billingProvider        String?
  lastProviderEventAt    DateTime?
  limitState             String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@index([billingProvider, externalSubscriptionId])
}

model BillingWebhookEvent {
  id             String        @id @default(cuid())
  provider       String
  eventId        String
  eventType      String
  organizationId String?
  occurredAt     DateTime
  processedAt    DateTime?
  payloadHash    String
  status         String        @default("received")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([provider, eventId])
  @@index([organizationId, occurredAt])
  @@index([status, createdAt])
}

model AnalysisRun {
  id             String       @id @default(cuid())
  organizationId String
  businessId     String
  idempotencyKey String
  requestId      String
  status         String       @default("queued")
  result         String?
  errorCode      String?
  queuedAt       DateTime     @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime     @updatedAt
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([businessId, status, queuedAt])
}

model JobLock {
  key         String   @id
  ownerId     String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model JobExecution {
  id          String    @id @default(cuid())
  jobName     String
  ownerId     String
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  result      String?
  errorCode   String?

  @@index([jobName, startedAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  targetType     String
  targetId       String?
  metadata       String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model IntegrationSecret {
  id             String       @id @default(cuid())
  organizationId String
  businessId     String?
  provider       String
  encryptedData  String
  keyVersion     String       @default("v1")
  status         String       @default("disconnected")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  business       Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, businessId, provider])
  @@index([organizationId, provider])
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  businessId     String?
  provider       String
  status         String       @default("disconnected")
  connectedAt    DateTime?
  lastSyncAt     DateTime?
  expiresAt      DateTime?
  scopes         String?
  metadata       String?
  lastErrorCode  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  business       Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
  @@index([businessId, provider])
  @@index([status, expiresAt])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipHash     String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  kind           String
  quantity       Int          @default(1)
  resourceId     String?
  periodKey      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, periodKey])
  @@index([organizationId, resourceId])
}

model Plan {
  id        String   @id @default(cuid())
  userId    String   @unique
  tier      String   @default("FREE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id                     String                  @id @default(cuid())
  userId                 String?
  organizationId         String?
  nombre                 String
  rubro                  String
  descripcion            String?
  ubicacion              String?
  ciudad                 String?
  pais                   String?
  tamano                 String?
  tipoCliente            String?
  publicoObjetivo        String?
  productosServicios     String?
  ticketPromedio         Float?
  empleados              String?
  webUrl                 String?
  instagramHandle        String?
  noWebDeclared          Boolean                 @default(false)
  noInstagramDeclared    Boolean                 @default(false)
  otrosCanales           String?
  canales                String?
  facturacion            Float?
  clientesMensuales      Int?
  inversionMarketing     Float?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  analysisHistory        AnalysisHistory[]
  analysisRuns           AnalysisRun[]
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id])
  goals                  BusinessGoal[]
  clarificationQuestions ClarificationQuestion[]
  diagnoses              Diagnosis[]
  instagramConnection    InstagramConnection?
  integrations           Integration[]
  integrationSecrets     IntegrationSecret[]
  scores                 NuvraScore[]
  strategies             Strategy[]
  websites               Website[]

  @@index([organizationId])
}

model BusinessGoal {
  id             String   @id @default(cuid())
  businessId     String
  objetivo       String
  objetivoCustom String?
  magnitud       Float?
  plazoDias      Int
  plazoLabel     String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Website {
  id         String            @id @default(cuid())
  businessId String
  url        String
  createdAt  DateTime          @default(now())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  analyses   WebsiteAnalysis[]
}

model WebsiteAnalysis {
  id              String    @id @default(cuid())
  websiteId       String
  status          String    @default("pending")
  pagesAnalyzed   Int       @default(0)
  rawData         String?
  screenshots     String?
  performanceData String?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  findings        Finding[]
  website         Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model InstagramConnection {
  id          String              @id @default(cuid())
  businessId  String              @unique
  status      String              @default("not_configured")
  igUserId    String?
  igUsername  String?
  accessToken String?
  tokenExpiry DateTime?
  scopes      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  analyses    InstagramAnalysis[]
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model InstagramAnalysis {
  id           String              @id @default(cuid())
  connectionId String
  status       String              @default("pending")
  rawData      String?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model NuvraScore {
  id         String           @id @default(cuid())
  businessId String
  total      Int?
  objetivo   String
  plazoDias  Int
  weights    String?
  createdAt  DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dimensions ScoreDimension[]
}

model ScoreDimension {
  id         String     @id @default(cuid())
  scoreId    String
  name       String
  slug       String
  points     Int
  weight     Float
  criteria   String?
  strengths  String?
  problems   String?
  source     String?
  confidence String?
  findings   Finding[]
  nuvraScore NuvraScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
}

model Finding {
  id                String           @id @default(cuid())
  dimensionId       String?
  websiteAnalysisId String?
  type              String
  category          String
  severity          String
  title             String
  description       String
  evidence          String
  pageUrl           String?
  source            String
  confidence        String
  impact            String?
  createdAt         DateTime         @default(now())
  websiteAnalysis   WebsiteAnalysis? @relation(fields: [websiteAnalysisId], references: [id])
  dimension         ScoreDimension?  @relation(fields: [dimensionId], references: [id])
}

model Diagnosis {
  id            String     @id @default(cuid())
  businessId    String
  summary       String
  bottleneck    String
  strengths     String
  weaknesses    String
  opportunities String
  risks         String
  priorities    String
  engineType    String     @default("deterministic")
  createdAt     DateTime   @default(now())
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  strategies    Strategy[]
}

model Strategy {
  id                  String            @id @default(cuid())
  businessId          String
  diagnosisId         String
  objetivo            String
  situacionActual     String
  distanciaObjetivo   String
  principalProblema   String
  prioridades         String
  frameworks          String?
  frameworksRationale String?
  engineType          String            @default("deterministic")
  createdAt           DateTime          @default(now())
  actions             StrategicAction[]
  diagnosis           Diagnosis         @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ClarificationQuestion {
  id         String                  @id @default(cuid())
  businessId String
  analysisId String?
  question   String
  reason     String
  dimension  String
  affects    String
  impact     String
  createdAt  DateTime                @default(now())
  business   Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  responses  ClarificationResponse[]
}

model ClarificationResponse {
  id         String                @id @default(cuid())
  questionId String
  businessId String
  answer     String
  source     String                @default("user")
  answeredAt DateTime              @default(now())
  question   ClarificationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model StrategicAction {
  id                 String    @id @default(cuid())
  strategyId         String
  title              String
  description        String?
  order              Int
  impact             String
  difficulty         String
  estimatedTime      String
  dependencies       String?
  indicatorToImprove String
  rationale          String
  relatedFindingIds  String?
  findingIds         String?
  evidence           String?
  inference          String?
  dimension          String?
  framework          String?
  confidence         String?
  problem            String?
  unlocksContent     Boolean   @default(false)
  done               Boolean   @default(false)
  status             String    @default("pending")
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime? @updatedAt
  strategy           Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model AnalysisHistory {
  id                String   @id @default(cuid())
  businessId        String
  scoreId           String?
  diagnosisId       String?
  strategyId        String?
  websiteAnalysisId String?
  nuvraScoreTotal   Int?
  snapshot          String?
  createdAt         DateTime @default(now())
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
